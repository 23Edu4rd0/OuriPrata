# Copie para .env e ajuste. O .env fica de fora do git (.gitignore).
#
# Em produção nada disto vem de arquivo: as variáveis são definidas no painel
# do Railway (ou pelo deploy-railway.sh).

# dev | production. Fora do Railway o padrão já é dev, então dá para omitir.
DJANGO_ENV=dev

# Em dev existe um valor padrão inseguro embutido, mas o ideal é gerar o seu:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Só tem efeito em dev (produção é sempre False).
DEBUG=True

# Sem isto o dev usa o SQLite em db.sqlite3. Aponte para um Postgres se quiser
# testar com o mesmo banco da produção.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/ouriprata

# --- Só produção -----------------------------------------------------------
# Domínios que respondem pelo site, separados por vírgula. O Railway injeta
# RAILWAY_PUBLIC_DOMAIN sozinho; preencha aqui só o domínio próprio.
# ALLOWED_HOSTS=ouriprata.com.br,www.ouriprata.com.br
# CSRF_TRUSTED_ORIGINS=https://ouriprata.com.br,https://www.ouriprata.com.br

# Caminho do volume persistente onde ficam as fotos das peças.
# MEDIA_ROOT=/app/media

# Suba para 31536000 (1 ano) depois de confirmar que o certificado está estável.
# SECURE_HSTS_SECONDS=3600

# LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=INFO
